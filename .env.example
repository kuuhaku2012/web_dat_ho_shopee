# Đường dẫn tuyệt đối đến thư mục dữ liệu bền vững (nếu bỏ trống: ./data)
DATA_DIR=
# Định dạng salt:hash (scrypt 64 byte, hex). Xem README để tạo.
ADMIN_PASSWORD_SCRYPT=
# Tên đăng nhập quản trị (nếu bỏ trống: admin)
ADMIN_USERNAME=admin
# Chuỗi ngẫu nhiên ít nhất 32 ký tự. Xem README để tạo.
SESSION_SECRET=
# Tên cá nhân/đơn vị chịu trách nhiệm về dữ liệu (điền trước khi công khai website)
PRIVACY_CONTROLLER_NAME=
# Email liên hệ về quyền riêng tư (không bắt buộc nếu dùng biểu mẫu trên website)
PRIVACY_CONTACT_EMAIL=
